{
  "name": "@arkitektio/bsx",
  "version": "1.0.1",
  "description": "The BSX language, the blok spec, runtime and React renderer: one copy for every Arkitekt frontend.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkitektio/bsx.git",
    "directory": "packages/bsx"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalogs": {
      "types": "./dist/catalogs.d.ts",
      "default": "./dist/catalogs.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./shadcn": {
      "types": "./dist/shadcn.d.ts",
      "default": "./dist/shadcn.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "default": "./dist/scene.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "default": "./dist/tailwind.js"
    },
    "./package.json": "./package.json",
    "./*.json": "./dist/*.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "theme": "node scripts/embed-theme.mjs",
    "build": "node scripts/embed-theme.mjs && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "spec:export": "node scripts/export-spec.mjs"
  },
